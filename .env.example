# ==============================================================================
# CAT OPERATOR SHIFT TWIN - MONOREPO ENVIRONMENT CONFIGURATION
# Copy this file to .env and adjust as necessary for local development.
# ==============================================================================

# Global Environment
ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Service Ports (Strict Hackathon Standard - Do NOT change without consensus)
FRONTEND_PORT=5173
GATEWAY_PORT=8080
SAFETY_SERVICE_PORT=8001
OPERATIONS_SERVICE_PORT=8002
TRAINING_SERVICE_PORT=8003
POSTGRES_PORT=5432

# PostgreSQL Database Configuration
POSTGRES_USER=cat_admin
POSTGRES_PASSWORD=cat_secure_password_2026
POSTGRES_DB=cat_shift_twin
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://cat_admin:cat_secure_password_2026@localhost:5432/cat_shift_twin

# Gateway Inter-Service Communication Endpoints (Local Defaults)
# In Docker Compose, these map to service hostnames
SAFETY_SERVICE_URL=http://localhost:8001
OPERATIONS_SERVICE_URL=http://localhost:8002
TRAINING_SERVICE_URL=http://localhost:8003

# Frontend Vite Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_TITLE="CAT Operator Shift Twin"
